# Export these environment variables in the shell before starting or building.
# The default setup works without creating an .env file.
SERVINEXO_WEB_ORIGIN=http://127.0.0.1:5175
SERVINEXO_CONTRACTOR_ORIGIN=http://127.0.0.1:5180
SERVINEXO_ADMIN_ORIGIN=http://127.0.0.1:5181
SERVINEXO_API_ORIGIN=http://127.0.0.1:5190
SERVINEXO_API_PORT=5190
# Optional PostgreSQL/PGlite data directory (one API process per directory).
DATABASE_DIR=.local/demo-state.pgdata
