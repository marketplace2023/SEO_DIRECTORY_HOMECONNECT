FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/admin/package.json ./apps/admin/package.json
COPY apps/contractor/package.json ./apps/contractor/package.json
# tsx is required by the current TypeScript API runtime.
RUN npm ci --include=dev && npm cache clean --force
COPY tsconfig.json ./
COPY src ./src
COPY server ./server
COPY scripts/demo-api.ts scripts/provision-cloud-accounts.ts ./scripts/
USER node
ENV NODE_ENV=production SERVINEXO_API_HOST=0.0.0.0 SERVINEXO_API_PORT=5190 DATABASE_DIR=/data/database UPLOAD_DIR=/data/uploads SERVINEXO_STATE_FILE=/data/state.json
EXPOSE 5190
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 CMD node -e "fetch('http://127.0.0.1:5190/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["sh", "-c", "node --import tsx scripts/provision-cloud-accounts.ts && exec node --import tsx scripts/demo-api.ts"]
